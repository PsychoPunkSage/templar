# =============================================================================
# Templar — Environment Variables
# Single source of truth for all services (API, web, analytics, infra).
#
# Setup:
#   cp .env.example .env        # fill in secrets
#   ln -s ../../.env apps/web/.env.local   # local Next.js dev (run once)
# =============================================================================

# Claude API
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgres://templar:templar@localhost:5432/templar

# S3 / MinIO
S3_BUCKET=templar-assets
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk) — get keys from clerk.com dashboard
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Decoded from publishable key: https://<instance>.clerk.accounts.dev/.well-known/jwks.json
# Leave empty in dev/test — auth is disabled and the seed MVP user is returned.
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# App
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server
API_PORT=8080
WEB_PORT=3000
RUST_LOG=info

# NATS — analytics event bus
NATS_URL=nats://localhost:4222
# NATS_URL=nats://nats:4222  # inside docker-compose network

# Analytics service
ANALYTICS_PORT=8090
ANALYTICS_NATS_STREAM=templar_events
ANALYTICS_NATS_SUBJECT=templar.events.*

# ClickHouse — raw event OLAP store
CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_URL=http://clickhouse:8123  # inside docker-compose network
CLICKHOUSE_DB=templar_analytics
CLICKHOUSE_USER=templar
CLICKHOUSE_PASSWORD=templar

# PostHog — self-hosted product analytics (http://localhost:8000 after first boot)
POSTHOG_SECRET_KEY=
POSTHOG_DB_PASSWORD=
POSTHOG_HOST=localhost
NEXT_PUBLIC_POSTHOG_KEY=phc_...        # from PostHog UI after first setup
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8000

# Grafana Cloud — get from grafana.com after creating a free account
# Prometheus remote_write: Connections → Prometheus → copy URL + credentials
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USERNAME=
GRAFANA_CLOUD_METRICS_PASSWORD=
# Loki push: grafana.com → stack Details → Loki section → copy URL + credentials
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOGS_USERNAME=
GRAFANA_CLOUD_LOGS_PASSWORD=
