# Claude API
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgres://templar:templar@localhost:5432/templar

# S3 / MinIO
S3_BUCKET=templar-pdfs
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Decoded from publishable key: https://<instance>.clerk.accounts.dev/.well-known/jwks.json
# Leave empty in dev/test — auth is disabled and the seed MVP user is returned.
CLERK_JWKS_URL=

# App
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server
API_PORT=8080
WEB_PORT=3001
RUST_LOG=info

# Fit scorer backend: "llm" (default, semantic via Claude) or "keyword" (fast, deterministic)
FIT_SCORER_BACKEND=llm

# Grafana Cloud — get endpoints from grafana.com after creating a free account
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_TOKEN=
